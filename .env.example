# ---- LLM provider (Groq free tier; get a key at console.groq.com) ----
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b        # fastest/cheapest free model
REASONING_EFFORT=low                 # low|medium|high -- low saves the most tokens
# To use another OpenAI-compatible free endpoint (e.g. Gemini/Cerebras), set:
# BASE_URL=https://...
# LLM_PROVIDER=openai_compatible

# =============================================================================
# ATTACH THIS TOOL TO ANY DATABASE  (Stage 1 -- everything is set right here)
# =============================================================================
# This ONE file fully describes a database connection AND its governance. To point
# the tool at a new database, you edit three things together, in this file:
#     1) DB_BACKEND + DATABASE_URL   -> which database to connect to
#     2) DENIED_COLUMNS / DENIED_TABLES / ALLOWED_TABLES -> what is off-limits
#     3) TABLE_ALIASES               -> optional prompt hints for that schema
# Keeping all three side by side means they can never drift out of sync (e.g. a new
# connection still pointing at the OLD database's denied columns). Restart the app
# after editing. If DENIED_COLUMNS and DENIED_TABLES are both empty, the app still
# starts but logs a visible warning -- an empty policy is never silent.

# ---- 1) which database -------------------------------------------------------
# DB_BACKEND=postgres    -> original psycopg backend (default). Uses DATABASE_URL.
# DB_BACKEND=sqlalchemy  -> multi-engine backend: Postgres / MySQL / SQLite / MSSQL.
#                           The engine is inferred from DATABASE_URL's prefix, and
#                           the SQL dialect for the safety layers is auto-detected.
DB_BACKEND=postgres
DATABASE_URL=postgresql://text2sql_ro:readonly@localhost:5432/shop
POOL_MAX_SIZE=10
# SQL_DIALECT=postgres   # normally auto-detected; override only in rare cases.
#
# Example DATABASE_URLs for DB_BACKEND=sqlalchemy (connect as a READ-ONLY user):
#   PostgreSQL : postgresql+psycopg://ro_user:pass@localhost:5432/mydb
#   MySQL      : mysql+pymysql://ro_user:pass@localhost:3306/mydb
#   SQLite     : sqlite:////absolute/path/to/mydb.sqlite
#   SQL Server : mssql+pyodbc://ro_user:pass@host:1433/mydb?driver=ODBC+Driver+18+for+SQL+Server
#
# ---- WORKED EXAMPLE: attach a MySQL "hospital" database ----------------------
# Uncomment and adapt all of these together, then restart:
#   DB_BACKEND=sqlalchemy
#   DATABASE_URL=mysql+pymysql://readonly:secret@10.0.0.5:3306/hospital
#   DENIED_COLUMNS=["patients.ssn","patients.mrn","patients.address"]
#   DENIED_TABLES=["billing_internal"]
#   TABLE_ALIASES={"patients":"p","admissions":"a","medications":"m"}
# That is the whole job -- connection + governance for the new schema, in one place.

# ---- guardrails / cost guard ----
MAX_ROWS=1000
# Hard ceiling on rows actually returned to a caller/UI, enforced independent of the
# in-SQL LIMIT and of the DB driver -- bounds data egress and payload size.
MAX_RESULT_ROWS=200
STATEMENT_TIMEOUT_MS=5000
MAX_PLAN_COST=1000000
MAX_PLAN_ROWS=5000000

# ---- 2) data governance for the connected database (JSON arrays) -------------
# Empty = allow all / deny none (the app warns at startup if BOTH deny lists empty).
# ALLOWED_TABLES=["customers","orders","products","order_items"]
# Policies use CANONICAL identifiers (table.column). Aliases in generated SQL are
# resolved to canonical form before this list is checked -- so you NEVER list
# "c.ssn"/"cust.ssn"; "customers.ssn" is enough.
DENIED_COLUMNS=["customers.ssn"]
# DENIED_COLUMNS=["customers.ssn","customers.phone"]   # deny multiple canonical columns
# DENIED_TABLES=["internal_audit"]

# ---- 3) optional alias SUGGESTIONS (canonical table -> preferred alias) -------
# A house style passed to the generation prompt only. NOT a security mechanism: the
# resolver maps ANY valid alias to its canonical table.column and the policy decides
# on that identity, so the model may use arbitrary aliases. Empty {} = no suggestion.
TABLE_ALIASES={"customers":"c","employees":"e","products":"p","orders":"o","order_items":"oi"}

# ---- hallucination detection / confidence ----
NUM_SAMPLES=5
TEMPERATURE=0.4
JUDGE_MODE=conditional               # always|conditional|off (conditional saves calls)
MIN_CONFIDENCE_TO_RETURN_ROWS=0.0   # e.g. 0.4 to withhold low-confidence results

# ---- caching ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ---- api auth + rate limiting (empty API_KEYS = auth disabled) ----
# API_KEYS=["key-for-client-a","key-for-client-b"]
RATE_LIMIT_PER_MINUTE=60
